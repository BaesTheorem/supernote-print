#!/usr/bin/env python3
"""Print command for ippeveprinter: deliver one job PDF to a Supernote.

ippeveprinter runs this once per job with the spooled file as argv[1] and the
IPP job attributes in the environment (IPP_JOB_NAME, CONTENT_TYPE, ...).
Delivery order:

  1. Browse & Access over the LAN (the device's built-in web server on
     port 8089), when the Supernote is on and the feature is switched on.
  2. Otherwise a folder inside the device's cloud sync tree (Google Drive,
     Dropbox, OneDrive), which lands on the device at its next sync.

Progress goes to stderr with the INFO:/ERROR: prefixes ippeveprinter expects.
"""

import ipaddress
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import uuid
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
from pathlib import Path
from urllib import error, request

CONFIG_DIR = Path(os.environ.get("SUPERNOTE_PRINT_CONFIG_DIR", "~/.config/supernote-print")).expanduser()
CONFIG_PATH = CONFIG_DIR / "config.json"
STATE_PATH = CONFIG_DIR / "state.json"
LOG_PATH = Path("~/Library/Logs/supernote-print/jobs.log").expanduser()

DEFAULTS = {
    "device_host": "auto",
    "device_port": 8089,
    "device_folder": "Document/Printed",
    "device_fallback_folders": ["Document", "INBOX"],
    "drive_folder": "",
    "notify": True,
    "notify_command": [],
    "scan_timeout": 0.5,
}

PAGE_JSON = re.compile(r"const json = '(\{.*?\})'", re.S)


def info(msg):
    sys.stderr.write(f"INFO: {msg}\n")
    sys.stderr.flush()
    log(msg)


def fail(msg):
    sys.stderr.write(f"ERROR: {msg}\n")
    sys.stderr.flush()
    log("ERROR " + msg)
    sys.exit(1)


def log(msg):
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOG_PATH.open("a") as fh:
        fh.write(f"{datetime.now():%Y-%m-%d %H:%M:%S} {msg}\n")


def load_config():
    cfg = dict(DEFAULTS)
    if CONFIG_PATH.exists():
        cfg.update(json.loads(CONFIG_PATH.read_text()))
    return cfg


def load_state():
    try:
        return json.loads(STATE_PATH.read_text())
    except (OSError, ValueError):
        return {}


def save_state(state):
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps(state))


def job_filename():
    name = os.environ.get("IPP_JOB_NAME") or "Untitled"
    name = Path(name).name
    name = re.sub(r"\.(pdf|ps|txt|docx?|pages|html?)$", "", name, flags=re.I)
    name = re.sub(r'[\\/:*?"<>|]+', "-", name)
    name = re.sub(r"\s+", " ", name).strip(" .-") or "Untitled"
    return f"{datetime.now():%Y-%m-%d %H%M} {name[:80]}.pdf"


def as_pdf(src, content_type):
    if content_type == "application/pdf" or src.read_bytes()[:5] == b"%PDF-":
        return src
    if content_type == "application/postscript":
        ps2pdf = shutil.which("ps2pdf")
        if not ps2pdf:
            fail("job is PostScript and ps2pdf (ghostscript) is not installed")
        out = src.with_suffix(".converted.pdf")
        subprocess.run([ps2pdf, str(src), str(out)], check=True)
        return out
    fail(f"unsupported document format {content_type}")


# --- Browse & Access -------------------------------------------------------

def device_page(host, port, path="/", timeout=3.0):
    """Return the JSON the device embeds in its file-listing page, or None."""
    url = f"http://{host}:{port}/{path.strip('/')}"
    try:
        with request.urlopen(url, timeout=timeout) as resp:
            body = resp.read().decode("utf-8", "replace")
    except (error.URLError, OSError, ValueError):
        return None
    m = PAGE_JSON.search(body)
    if not m:
        return None
    try:
        return json.loads(m.group(1))
    except ValueError:
        return None


def local_subnet():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.0.2.1", 9))
        ip = s.getsockname()[0]
    finally:
        s.close()
    return ipaddress.ip_network(f"{ip}/24", strict=False), ip


def scan_for_device(port, timeout):
    net, me = local_subnet()
    hosts = [str(h) for h in net.hosts() if str(h) != me]

    def probe(host):
        try:
            with socket.create_connection((host, port), timeout=timeout):
                pass
        except OSError:
            return None
        return host if device_page(host, port, timeout=timeout * 4) else None

    with ThreadPoolExecutor(max_workers=64) as pool:
        for host in pool.map(probe, hosts):
            if host:
                return host
    return None


def find_device(cfg, state):
    port = cfg["device_port"]
    candidates = []
    if cfg["device_host"] and cfg["device_host"] != "auto":
        candidates.append(cfg["device_host"])
    if state.get("last_host"):
        candidates.append(state["last_host"])
    for host in candidates:
        if device_page(host, port, timeout=2.0):
            return host
    if cfg["device_host"] == "auto":
        return scan_for_device(port, cfg["scan_timeout"])
    return None


def multipart(field, filename, data):
    boundary = uuid.uuid4().hex
    body = (
        f"--{boundary}\r\n"
        f'Content-Disposition: form-data; name="{field}"; filename="{filename}"\r\n'
        "Content-Type: application/pdf\r\n\r\n"
    ).encode() + data + f"\r\n--{boundary}--\r\n".encode()
    return f"multipart/form-data; boundary={boundary}", body


def upload_to_device(host, port, folder, filename, pdf):
    url = f"http://{host}:{port}/{folder.strip('/')}"
    ctype, body = multipart("file", filename, pdf.read_bytes())
    req = request.Request(url, data=body, method="POST")
    req.add_header("Content-Type", ctype)
    try:
        with request.urlopen(req, timeout=120) as resp:
            if resp.status // 100 != 2:
                return False
    except (error.URLError, OSError):
        return False
    listing = device_page(host, port, folder) or {}
    return any(f.get("name") == filename for f in listing.get("fileList", []))


def deliver_to_device(cfg, state, filename, pdf):
    host = find_device(cfg, state)
    if not host:
        return None
    folders = [cfg["device_folder"], *cfg["device_fallback_folders"]]
    seen = set()
    for folder in folders:
        if not folder or folder in seen:
            continue
        seen.add(folder)
        if upload_to_device(host, cfg["device_port"], folder, filename, pdf):
            state["last_host"] = host
            save_state(state)
            return f"{host}:{cfg['device_port']}/{folder.strip('/')}"
        info(f"device {host} refused {folder}/, trying the next folder")
    return None


# --- Cloud sync folder -------------------------------------------------------

def deliver_to_drive(cfg, filename, pdf):
    if not cfg["drive_folder"]:
        return None
    folder = Path(cfg["drive_folder"]).expanduser()
    folder.mkdir(parents=True, exist_ok=True)
    dest = folder / filename
    shutil.copyfile(pdf, dest)
    if dest.stat().st_size != pdf.stat().st_size:
        fail(f"copy to {dest} came out short")
    return str(dest)


def notify(cfg, message, link):
    if not cfg["notify"]:
        return
    cmd = cfg["notify_command"]
    if cmd and Path(cmd[0]).exists():
        subprocess.run([*cmd, message, "Supernote", "none", link], check=False)
        return
    script = f'display notification "{message}" with title "Supernote"'
    subprocess.run(["osascript", "-e", script], check=False)


def main():
    if len(sys.argv) > 1:
        src = Path(sys.argv[1])
    else:
        src = Path(f"/tmp/supernote-print-{os.getpid()}.job")
        src.write_bytes(sys.stdin.buffer.read())
    cfg = load_config()
    state = load_state()
    filename = job_filename()
    pdf = as_pdf(src, os.environ.get("CONTENT_TYPE", ""))

    info(f"looking for the Supernote on the LAN for {filename}")
    where = deliver_to_device(cfg, state, filename, pdf)
    if where:
        info(f"uploaded {filename} to {where}")
        notify(cfg, f"Printed {filename} straight to the device.", f"http://{where.rsplit('/', 1)[0]}")
        return

    where = deliver_to_drive(cfg, filename, pdf)
    if where:
        info(f"device not reachable; saved {filename} to {where} (arrives on next sync)")
        notify(cfg, f"Saved {filename} for the next Supernote sync.", where)
        return

    fail("Supernote not reachable and no drive_folder configured")


if __name__ == "__main__":
    main()
